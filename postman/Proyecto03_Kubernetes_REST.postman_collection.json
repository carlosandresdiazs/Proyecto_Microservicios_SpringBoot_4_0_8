    {
      "name": "04 - Pagos OAuth 2.0 / Keycloak (payment-service)",
      "item": [
        {
          "name": "Obtener token Keycloak POST (client_credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{keycloakUrl}}/realms/proyecto03/protocol/openid-connect/token",
            "description": "Obtener token Keycloak POST (client_credentials)",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{keycloakClientSecret}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j=pm.response.json();pm.environment.set('paymentToken',j.access_token);pm.test('Token OAuth',()=>pm.expect(j.access_token).to.be.a('string')); "
                ]
              }
            }
          ]
        },
        {
          "name": "Crear pago POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/payments",
            "description": "Crear pago POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paymentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{paymentOrderId}}\",\n  \"amount\": 45000,\n  \"currency\": \"COP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('paymentId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar mis pagos GET",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
