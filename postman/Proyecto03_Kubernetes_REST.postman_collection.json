{
  "info": {
    "name": "Proyecto 03 - Spring Boot 4.0.8 - Microservicios Kubernetes REST",
    "_postman_id": "c173eb1d-1109-45d3-8778-c3e56bad5968",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de rutas verificadas en los controladores. Ejecutar por carpetas: 00, 01 registro/login, 02 usuarios, 03 productos, 04 pagos, 05 seguridad. ADMIN se debe aprovisionar por separado. Keycloak usa client_credentials para payments-machine. Las rutas de pagos NO incluyen PUT ni DELETE. El webhook HMAC requiere firma exacta y se documenta por separado."
  },
  "item": [
    {
      "name": "00 - Kubernetes y salud",
      "item": [
        {
          "name": "Gateway - health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Gateway - health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado UP',()=>pm.expect(pm.response.json().status).to.eql('UP'));",
                  "pm.test('Correlation ID presente',()=>pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string')); "
                ]
              }
            }
          ]
        },
        {
