
# Normalizar los archivos de texto
* text=auto

# Código fuente y configuraciones
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Scripts de Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.zip binary
*.pdf binary
